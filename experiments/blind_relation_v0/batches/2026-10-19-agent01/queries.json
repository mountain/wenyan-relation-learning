[
  {
    "id": "q-1d8a50680cb4e5dc",
    "text": "「疏钟」获其所授「玉环」。"
  },
  {
    "id": "q-53ffc1ac7d41de6c",
    "text": "「凝璧」获「栖岚」所授「照汀」。"
  },
  {
    "id": "q-5a072b2cfd8f2278",
    "text": "「照汀」获「凝璧」所授「栖岚」。"
  },
  {
    "id": "q-b49dfb42b72f7315",
    "text": "「映雪」授「澄霄」「闻溪」。"
  },
  {
    "id": "q-e6377d79bcb74477",
    "text": "「石泉」得「兰舟」所赠之「玉筹」。"
  },
  {
    "id": "q-3fc2286818cdd770",
    "text": "「闻溪」获「映雪」所授「澄霄」。"
  },
  {
    "id": "q-07c52b55a45f637b",
    "text": "「澄霄」授「闻溪」「映雪」。"
  },
  {
    "id": "q-3e7ba8937c9db2e2",
    "text": "「闻溪」把「澄霄」交给「映雪」。"
  },
  {
    "id": "q-b7d71879aae4a4d8",
    "text": "「沧弦」付「银钥」于「墨川」。"
  },
  {
    "id": "q-334e83380ee51d4a",
    "text": "「澄霄」把「映雪」交给「闻溪」。"
  },
  {
    "id": "q-107c74a4a8ead036",
    "text": "「云汀」赠「翠牌」于「岚客」，「岚客」又转赠「石符」于「云汀」。"
  },
  {
    "id": "q-c86087176d5437c9",
    "text": "「栖岚」获「凝璧」所授「照汀」。"
  },
  {
    "id": "q-b83b872c39f8abb1",
    "text": "「栖岚」授「照汀」「凝璧」。"
  },
  {
    "id": "q-b66e6afb65e968bc",
    "text": "「照汀」授「栖岚」「凝璧」。"
  },
  {
    "id": "q-85c0737acb667c94",
    "text": "「映雪」获「闻溪」所授「澄霄」。"
  },
  {
    "id": "q-326532c796b43b7b",
    "text": "「岑渚」以「玄印」予「洛衡」。"
  },
  {
    "id": "q-1512b0a90cc10f33",
    "text": "「映雪」把「闻溪」交给「澄霄」。"
  },
  {
    "id": "q-4da9dc7d2a919ce0",
    "text": "「凝璧」把「栖岚」交给「照汀」。"
  },
  {
    "id": "q-4b925a31c470df16",
    "text": "「栖岚」授「凝璧」「照汀」。"
  },
  {
    "id": "q-6003df1d0824d034",
    "text": "「凝璧」授「栖岚」「照汀」。"
  },
  {
    "id": "q-de72cd07669e8a33",
    "text": "「澄霄」获「闻溪」所授「映雪」。"
  },
  {
    "id": "q-b936b6f926f9e2ab",
    "text": "「兰舟」得「石泉」所赠之「玉筹」。"
  },
  {
    "id": "q-8538e6040e6de914",
    "text": "「照汀」授「凝璧」「栖岚」。"
  },
  {
    "id": "q-9fd26471cf3c5697",
    "text": "「映雪」授「闻溪」「澄霄」。"
  },
  {
    "id": "q-2e6cafb30c369943",
    "text": "「澄霄」把「闻溪」交给「映雪」。"
  },
  {
    "id": "q-c419d7387cc516fa",
    "text": "「凝璧」把「照汀」交给「栖岚」。"
  },
  {
    "id": "q-ae2b3f1f26117a9d",
    "text": "「闻溪」获「澄霄」所授「映雪」。"
  },
  {
    "id": "q-1edea097002e6280",
    "text": "「汀兰」把「紫绶」交给谁？"
  },
  {
    "id": "q-64beb96c171ecd84",
    "text": "「闻溪」授「映雪」「澄霄」。"
  },
  {
    "id": "q-82ec0e2b4ab7ea55",
    "text": "「映雪」把「澄霄」交给「闻溪」。"
  },
  {
    "id": "q-871b6697883c1f2e",
    "text": "「栖岚」获「照汀」所授「凝璧」。"
  },
  {
    "id": "q-86912562fd92ec2a",
    "text": "「闻溪」授「澄霄」「映雪」。"
  },
  {
    "id": "q-96d5a4200485107b",
    "text": "「澄霄」获「映雪」所授「闻溪」。"
  },
  {
    "id": "q-44190d6ca74d5bb4",
    "text": "「晴渡」把「银笺」交给「临波」或「远棠」。"
  },
  {
    "id": "q-e546b1fac2e4d286",
    "text": "「闻溪」把「映雪」交给「澄霄」。"
  },
  {
    "id": "q-2abd094d1bfc98a9",
    "text": "「栖岚」把「照汀」交给「凝璧」。"
  },
  {
    "id": "q-6a2470fb3e06853e",
    "text": "「松砚」授「竹澜」。"
  },
  {
    "id": "q-c0c23dc7b244a828",
    "text": "「凝璧」授「照汀」「栖岚」。"
  },
  {
    "id": "q-2eb8d0a317fc84c8",
    "text": "「栖岚」把「凝璧」交给「照汀」。"
  },
  {
    "id": "q-0b1e11a3a151977f",
    "text": "「照汀」把「凝璧」交给「栖岚」。"
  },
  {
    "id": "q-4b5ae357486d86f8",
    "text": "「映雪」获「澄霄」所授「闻溪」。"
  },
  {
    "id": "q-ec81597fe01ccc96",
    "text": "「素川」授「丹峤」「墨札」，抑「丹峤」授「素川」「墨札」？"
  },
  {
    "id": "q-a3ce7b24278401dd",
    "text": "「洛衡」以「玄印」予「岑渚」。"
  },
  {
    "id": "q-30318270b53a2c59",
    "text": "「照汀」把「栖岚」交给「凝璧」。"
  },
  {
    "id": "q-b846f09205ca89ce",
    "text": "「澄霄」授「映雪」「闻溪」。"
  },
  {
    "id": "q-5ee209a427cf32fd",
    "text": "「墨川」付「银钥」于「沧弦」。"
  },
  {
    "id": "q-5dadb92ac8478bfe",
    "text": "「照汀」获「栖岚」所授「凝璧」。"
  },
  {
    "id": "q-7ad577f82bbe7ba7",
    "text": "「凝璧」获「照汀」所授「栖岚」。"
  }
]
