    "examples": {
      "yue-quote": {
        "work": "analects",
        "section": "analects.1",
        "passageId": "1.1",
        "sourcePage": "論語/學而第一",
        "sourceRevid": 2058123,
        "text": "子曰：「學而時習之，不亦說乎？有朋自遠方來，不亦樂乎？人不知而不慍，不亦君子乎？」",
        "occurrences": [
          {
            "slot": 0,
            "value": "子",
            "start": 0,
            "end": 1
          },
          {
            "slot": 1,
            "value": "學而時習之，不亦說乎？有朋自遠方來，不亦樂乎？人不知而不慍，不亦君子乎？",
            "start": 4,
            "end": 40
          }
        ]
      },
      "wen-quote": {
        "work": "analects",
        "section": "analects.1",
        "passageId": "1.10",
        "sourcePage": "論語/學而第一",
        "sourceRevid": 2058123,
        "text": "子禽問於子貢曰：「夫子至於是邦也，必聞其政，求之與？抑與之與？」子貢曰：「夫子溫、良、恭、儉、讓以得之。夫子之求之也，其諸異乎人之求之與？」",
        "occurrences": [
          {
            "slot": 0,
            "value": "子禽",
            "start": 0,
            "end": 2
          },
          {
            "slot": 1,
            "value": "於子貢",
            "start": 3,
            "end": 6
          },
          {
            "slot": 2,
            "value": "夫子至於是邦也，必聞其政，求之與？抑與之與？",
            "start": 9,
            "end": 31
          }
        ]
      },
      "wen-plain": {
        "work": "analects",
        "section": "analects.2",
        "passageId": "2.19",
        "sourcePage": "論語/爲政第二",
        "sourceRevid": 2058121,
        "text": "哀公問曰：「何爲則民服？」孔子對曰：「擧直錯諸枉，則民服；擧枉錯諸直，則民不服。」",
        "occurrences": [
          {
            "slot": 0,
            "value": "哀公",
            "start": 0,
            "end": 2
          },
          {
            "slot": 1,
            "value": "何爲則民服？",
            "start": 6,
            "end": 12
          }
        ]
      },
      "wei-quote": {
        "work": "analects",
        "section": "analects.2",
        "passageId": "2.21",
        "sourcePage": "論語/爲政第二",
        "sourceRevid": 2058121,
        "text": "或謂孔子曰：「子奚不爲政？」子曰：「《書》云：『孝乎惟孝，友於兄弟。』施於有政，是亦爲政，奚其爲爲政？」",
        "occurrences": [
          {
            "slot": 0,
            "value": "或",
            "start": 0,
            "end": 1
          },
          {
            "slot": 1,
            "value": "孔子",
            "start": 2,
            "end": 4
          },
          {
            "slot": 2,
            "value": "子奚不爲政？",
            "start": 7,
            "end": 13
          }
        ]
      },
      "yu-quote": {
        "work": "analects",
        "section": "analects.13",
        "passageId": "13.18",
        "sourcePage": "論語/子路第十三",
        "sourceRevid": 1956460,
        "text": "葉公語孔子曰：「吾黨有直躬者，其父攘羊，而子證之。」孔子曰：「吾黨之直者異於是，父爲子隱，子爲父隱，直在其中矣。」",
        "occurrences": [
          {
            "slot": 0,
            "value": "葉公",
            "start": 0,
            "end": 2
          },
          {
            "slot": 1,
            "value": "孔子",
            "start": 3,
            "end": 5
          },
          {
