    "examples": {
      "yue-quote": {
        "work": "analects",
        "section": "analects.1",
        "passageId": "1.1",
        "sourcePage": "論語/學而第一",
        "sourceRevid": 2058123,
        "text": "子曰：「學而時習之，不亦說乎？有朋自遠方來，不亦樂乎？人不知而不慍，不亦君子乎？」",
